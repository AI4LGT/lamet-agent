      "jobs": [
        {
          "id": "fourier_real",
          "inputs": {
            "input": "renormalized_b1"
          },
          "tmdwf_projection": "real"
        },
        {
          "id": "fourier_imag",
          "inputs": {
            "input": "renormalized_b1"
          },
          "tmdwf_projection": "imag"
