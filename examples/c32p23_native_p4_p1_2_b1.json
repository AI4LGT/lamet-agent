              }
            ]
          }
        }
      ]
    },
    "renormalization": {
      "jobs": [
        {
          "id": "wilson_b1",
          "settings": {
            "b": 1,
            "a_fm": 0.1053,
            "L": 6,
            "ZO": 0.92208,
            "fit_start": 5,
            "fit_stop": 20,
            "priors": {
